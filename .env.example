# Copy to .env (gitignored; mise auto-loads it). Every variable any tool reads.
# The build needs none. Data-source and deployment variables are added by the tasks
# that need them.

# Telegram refresh reports (mise run notify; repo secrets of the same names in CI).
# A dedicated bot from @BotFather, never mario's token.
TELEGRAM_BOT_TOKEN=
# The chat the bot posts to: message the bot, then read chat.id from getUpdates.
TELEGRAM_CHAT_ID=
